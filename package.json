{
  "name": "ford-service-pulse",
  "version": "1.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "api": "node api/server.js",
    "build:data": "python scripts/build-service-summary.py",
    "build:apk": "eas build --platform android --profile preview",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=spec tests/domain.test.ts tests/api.test.ts",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.4.1",
    "expo": "~54.0.27",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.17",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
