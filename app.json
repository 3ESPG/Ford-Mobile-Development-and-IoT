{
  "expo": {
    "name": "Ford Service Pulse",
    "slug": "ford-service-pulse",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fordservicepulse",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F7F8FB",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.fiap.fordservicepulse",
      "infoPlist": {
        "NSMotionUsageDescription": "O acelerômetro é usado para avaliar o estilo de condução e estimar o desgaste de freios e pneus."
      }
    },
    "android": {
      "package": "br.com.fiap.fordservicepulse",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00095B"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#00095B"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "O acelerômetro é usado para avaliar o estilo de condução e estimar o desgaste de freios e pneus."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "",
      "router": {},
      "eas": {
        "projectId": "4f225b2a-c3e9-45b9-8e0b-e537675d2300"
      }
    },
    "owner": "fbraunstein"
  }
}
